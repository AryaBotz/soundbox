# Copy this file to .env, then change both local-only keys before using the LAN.
HOST=0.0.0.0
PORT=8787
NODE_ENV=development
DATA_FILE=./data/events.json

# Local development only. Simulation is never a verified payment.
SIMULATOR_ENABLED=true
SIMULATOR_API_KEY=local-dev-simulator-key-change-this

# Set this key on the ESP32 and send it as X-Device-Key.
DEVICE_API_KEY=local-dev-device-key-change-this

# Optional cloud TTS. Create a SonexLabs account for the free 10,000-character tier.
# Keep the API key only in this local .env file.
SONEXLABS_API_KEY=

# Remains disabled until Midtrans GoPay Static QRIS approval and configuration.
MIDTRANS_WEBHOOK_ENABLED=false
MIDTRANS_SERVER_KEY=
MIDTRANS_ALLOWED_PAYMENT_TYPE=
